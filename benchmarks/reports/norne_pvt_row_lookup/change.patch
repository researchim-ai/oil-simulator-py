+def interp_rows_pair(x, XP, FP, GP):
+    """Two properties on one row grid; share discrete lookup, not AD arithmetic."""
+    i = torch.searchsorted(XP, x.detach().contiguous().unsqueeze(1), right=True).clamp(1, XP.shape[1] - 1)
+    lower = i - 1
+    x0, x1 = XP.gather(1, lower).squeeze(1), XP.gather(1, i).squeeze(1)
+
+    def evaluate(values):
+        y0, y1 = values.gather(1, lower).squeeze(1), values.gather(1, i).squeeze(1)
+        return y0 + (y1 - y0) * (x - x0) / (x1 - x0)
+
+    return evaluate(FP), evaluate(GP)
+
